# Copy to back-end/.env and fill in. NEVER commit a real .env.

# Flask secret + JWT signing key. Use a long random value in production, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

# Path to the SQLite database file (relative to the back-end working dir).
DATABASE_PATH=navigator.db

# development | production
FLASK_ENV=development

# Allowed front-end origin (split-origin CORS). The static SPA runs here.
CORS_ORIGIN=http://127.0.0.1:5500
